# Copy to .env and fill in. NEVER commit the real .env file.

# Required: 32+ characters. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

DATABASE_URL=sqlite:///./worksphere.db
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Comma-separated list of allowed browser origins (leave empty for same-origin only)
CORS_ORIGINS=

# Email integration (Module 25). When EMAIL_ENABLED=false, emails are only logged.
EMAIL_ENABLED=false
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
SMTP_FROM=hr@example.com

# Used only by seed.py. If empty, a random password is generated and printed once.
SEED_ADMIN_PASSWORD=
